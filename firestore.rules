rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@examora.app';
    }
    match /users/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.role in ['student', 'teacher'];
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow update: if isAdmin() || (request.auth != null && request.auth.uid == uid
        && resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teachers']));
      allow delete: if isAdmin();
    }
    match /private/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow update, delete: if isAdmin();
    }
    match /codes/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && request.resource.data.teacherUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /phones/{phone} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
